# Game Configuration Examples

# Render distance (chunks): 2-16
# Default: 8
# Higher values = more chunks visible but lower FPS
VITE_RENDER_DISTANCE=8

# Field of View (degrees): 30-120
# Default: 75
# Higher values = wider view
VITE_FOV=75

# Mouse sensitivity: 0.1-3.0
# Default: 1.0
VITE_MOUSE_SENSITIVITY=1.0

# View distance (world units)
# Default: 500
VITE_VIEW_DISTANCE=500

# Fog distance (world units)
# Default: 1000
VITE_FOG_DISTANCE=1000

# Development server host
VITE_HOST=localhost

# Development server port
VITE_PORT=5173
